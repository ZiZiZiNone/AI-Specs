# 统一行尾为 LF，避免 CRLF 工作区每次提交产生全文件假改动
* text=auto eol=lf

# 文档一律 LF
*.md text eol=lf

# 代码与配置
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.vue text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.yml text eol=lf

# 二进制，禁止行尾转换
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
